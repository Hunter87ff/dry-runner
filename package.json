{
    "name": "dry-runner",
    "displayName": "Dry Runner",
    "description": "Run C,C++, Python, Java, PHP, Javascript, TypeScript, Dart, Kotlin and many more in one click.",
    "version": "1.1.0",
    "publisher": "Spruce87",
    "author": {
        "name": "Hunter87"
    },
    "license": "MIT",
    "homepage": "https://github.com/hunter87ff/dry-runner",
    "repository": {
        "type": "git",
        "url": "https://github.com/hunter87ff/dry-runner"
    },
    "bugs": {
        "url": "https://github.com/hunter87ff/dry-runner/issues"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "keywords": [
        "dry-runner",
        "run",
        "c",
        "cpp",
        "javascript",
        "php",
        "python",
        "java",
        "kotlin",
        "path customizable code runner"
    ],
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "dry-runner.run",
                "title": "Run",
                "icon": "$(debug-start)"
            },
            {
                "command": "dry-runner.restart",
                "title": "Run",
                "icon": "$(debug-start)"
            },
            {
                "command": "dry-runner.stop",
                "title": "Stop",
                "icon": "$(debug-stop)"
            },
            {
                "command": "dry-runner.environ",
                "title": "Set Environment",
                "icon": "$(gear)"
            }
        ],
        "configuration": {
            "title": "dry-runner",
            "properties": {
                "dry-runner.commands": {
                    "type": "object",
                    "scope": "window",
                    "default": {
                        "js": "cd {workspace} && node {filepath}",
                        "py": "cd {workspace} && python {filepath}",
                        "ts": "cd {workspace} && ts-node {filepath}",
                        "php": "cd {workspace} && php {filepath}",
                        "dart": "cd {workspace} && dart {filepath}",
                        "go": "cd {workspace} && go run {filepath}",
                        "sh": "cd {workspace} && bash {filepath}",
                        "rb": "cd {workspace} && ruby {filepath}",
                        "swift": "cd {workspace} && swift {filepath}",
                        "lua": "cd {workspace} && lua {filepath}",
                        "pl": "cd {workspace} && perl {filepath}",
                        "r": "cd {workspace} && Rscript {filepath}",
                        "scala": "cd {workspace} && scalac {filepath} && scala {filenameNoExt}",
                        "java": "cd {workspace} && javac {filepath} && java {filenameNoExt}",
                        "c": "cd {workspace} && gcc {filepath} -o {filenameNoExt} && {filepathNoExt}",
                        "cpp": "cd {workspace} && g++ {filepath} -o {filenameNoExt} && {filepathNoExt}",
                        "cs": "cd {workspace} && csc {filepath} -out:{filenameNoExt}.exe && {filepathNoExt}.exe",
                        "rs": "cd {workspace} && rustc {filepath} -o {filenameNoExt} && {filepathNoExt}",
                        "kt": "cd {workspace} && kotlinc {filepath} -include-runtime -d {filenameNoExt}.jar && java -jar {filepathNoExt}.jar"
                    },
                    "additionalProperties": {
                        "type": "string"
                    },
                    "markdownDescription": "Customize the command for different languages. some placeholders : `{workspace}`, `{filepath}`, `{filename}`, `{filenameNoExt}`"
                }
            }
        },
        "keybindings": [
            {
                "command": "dry-runner.run",
                "when": "!dry-runner.running",
                "key": "f5"
            },
            {
                "command": "dry-runner.restart",
                "when": "dry-runner.running",
                "key": "f5"
            },
            {
                "command": "dry-runner.stop",
                "when": "dry-runner.running",
                "key": "f4"
            },
            {
                "command": "dry-runner.environ",
                "key": "ctrl+shift+f5"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "command": "dry-runner.run",
                    "when": "!dry-runner.running"
                },
                {
                    "command": "dry-runner.restart",
                    "when": "dry-runner.running"
                }
            ],
            "editor/context": [
                {
                    "command": "dry-runner.run",
                    "when": "!dry-runner.running",
                    "group": "navigation"
                },
                {
                    "command": "dry-runner.restart",
                    "when": "dry-runner.running",
                    "group": "navigation"
                },
                {
                    "command": "dry-runner.stop",
                    "when": "dry-runner.running",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "build": "vsce package",
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^7.1.4",
        "@types/minimatch": "^6.0.0",
        "@types/mocha": "^9.0.0",
        "@types/node": "14.x",
        "@types/vscode": "^1.63.0",
        "@typescript-eslint/eslint-plugin": "^5.1.0",
        "@typescript-eslint/parser": "^5.1.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^8.1.0",
        "glob": "^7.1.7",
        "mocha": "^11.1.0",
        "typescript": "^4.9.5"
    },
    "overrides": {
        "mocha": {
            "diff": "8.0.3",
            "serialize-javascript": "7.0.5"
        }
    }
}
